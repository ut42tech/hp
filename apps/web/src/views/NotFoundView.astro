---
import UiIcon from "../components/UiIcon.vue";
import { localizePath, type Locale } from "../i18n/config";
import { useTranslations } from "../i18n/t";
import Site from "../layouts/Site.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<Site locale={locale} section="not-found" title={t("notFound.title")}>
  <!-- Same ground as Hello, so a wrong URL still feels like the site; the nav bar leads on from here. -->
  <div class="not-found">
    <p class="text-display text-fg" aria-hidden="true">
      {t("notFound.code")}
    </p>
    <h1 class="mt-4 text-callout text-muted lg:mt-5">{t("notFound.title")}</h1>
    <a href={localizePath("/", locale)} class="home text-callout font-bold" data-cursor="block">
      <UiIcon name="chevron-left" size={14} />
      {t("notFound.home")}
    </a>
  </div>
</Site>

<style>
  .not-found {
    position: fixed;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-inline: 16px;
    text-align: center;
  }

  .home {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 36px;
    margin-top: 24px;
    padding: 0 16px 0 12px;
    border-radius: var(--ut-radius-full);
    background: var(--ut-color-fill);
    color: var(--ut-color-fg);
  }
</style>
