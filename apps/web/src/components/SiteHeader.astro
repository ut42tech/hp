---
import type { Locale } from "../i18n/config";
import { localizePath } from "../i18n/config";
import { useTranslations } from "../i18n/t";
import LocaleSwitch from "./LocaleSwitch.astro";
import ThemeToggle from "./ThemeToggle.vue";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const labels = { auto: t("theme.auto"), light: t("theme.light"), dark: t("theme.dark") };
---

<header class="site-header">
  <a href={localizePath("/", locale)} class="text-headline text-fg" data-cursor="block">
    @ut42tech
  </a>
  <div class="flex items-center">
    <LocaleSwitch locale={locale} />
    <ThemeToggle client:load labels={labels} />
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: calc(var(--top-inset) + var(--row));
    padding-top: var(--top-inset);
    padding-inline: var(--gutter-left) calc(var(--gutter-right) - 12px);
    view-transition-name: site-header;
  }

  /* Desktop: pages scroll under the header, so it takes the page colour to keep its controls clear
     (without it, the toggles sit on top of the cards at 1024–1130px). */
  @media (width >= 64rem) {
    .site-header {
      height: 76px;
      padding: 0 20px 0 32px;
      background: var(--ut-color-bg);
    }
  }
</style>
