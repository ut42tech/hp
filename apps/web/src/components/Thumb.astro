---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import type { BrandIconName } from "../lib/icons";
import BrandIcon from "./BrandIcon.vue";

interface Props {
  image?: ImageMetadata;
  alt: string;
  initial: string;
  brand?: BrandIconName;
  widths: number[];
  sizes: string;
  class?: string;
}

const { image, alt, initial, brand, widths, sizes, class: className } = Astro.props;
---

<div class:list={["thumb", className]}>
  {image ? (
    <Image src={image} alt={alt} widths={widths} sizes={sizes} class="size-full object-cover" />
  ) : (
    <div class="grid size-full place-items-center text-muted" aria-hidden="true">
      {brand ? <BrandIcon name={brand} size={32} /> : <span class="text-title-m">{initial}</span>}
    </div>
  )}
</div>

<style>
  .thumb {
    overflow: hidden;
    background: var(--ut-color-placeholder);
  }
</style>
