---
import { publishedLocales, switchLocalePath, type Locale } from "../i18n/config";
import { useTranslations } from "../i18n/t";
import UiIcon from "./UiIcon.vue";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const other = publishedLocales.find((l) => l !== locale);
---

{other && (
  <a
    href={switchLocalePath(Astro.url.pathname, other)}
    hreflang={other}
    lang={other}
    class="grid size-11 place-items-center text-fg"
    aria-label={t("locale.switch")}
    data-cursor="block"
    data-locale-switch
  >
    <UiIcon name="language" size={20} />
  </a>
)}

<script>
  import { LOCALE_COOKIE } from "../i18n/config";

  // Remember the chosen language so "/" can send this visitor there next time.
  document.addEventListener("click", (event) => {
    const link = (event.target as Element | null)?.closest<HTMLAnchorElement>(
      "[data-locale-switch]",
    );
    if (!link) return;
    document.cookie = `${LOCALE_COOKIE}=${link.hreflang}; max-age=31536000; path=/; samesite=lax`;
  });
</script>
