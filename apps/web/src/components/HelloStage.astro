---
import type { Locale } from "../i18n/config";
import { useTranslations } from "../i18n/t";

interface Props {
  locale: Locale;
  // Behind a sheet the greeting is scenery: hidden from assistive tech and not the page heading.
  decorative?: boolean;
}

const { locale, decorative = false } = Astro.props;
const t = useTranslations(locale);
const title = t("hello.title");
const Heading = decorative ? "p" : "h1";
---

<div
  class:list={["hello-stage", { "is-decorative": decorative }]}
  aria-hidden={decorative ? "true" : undefined}
>
  <Heading class="text-display text-fg" aria-label={decorative ? undefined : title}>
    {[...title].map((letter) => (
      <span class="letter" aria-hidden="true">
        {letter}
      </span>
    ))}
  </Heading>
  <p class="mt-4 text-callout text-muted lg:mt-5">{t("hello.sub")}</p>
</div>

<style>
  .hello-stage {
    position: fixed;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-inline: 16px;
    text-align: center;
  }

  .letter {
    display: inline-block;
  }

  @media (width >= 64rem) {
    .hello-stage.is-decorative {
      display: none;
    }
  }
</style>
