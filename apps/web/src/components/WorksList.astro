---
import { localizePath, type Locale } from "../i18n/config";
import { useTranslations } from "../i18n/t";
import { getWorks } from "../lib/content";
import { formatMonth, formatPeriod, initialOf, type Category } from "../lib/works";
import Card from "./Card.astro";
import PageHead from "./PageHead.astro";
import RowCard from "./RowCard.astro";

interface Props {
  category: Category;
  locale: Locale;
}

const { category, locale } = Astro.props;
const t = useTranslations(locale);
// Mark entries that fell back to another language so screen readers pronounce them correctly.
const langOf = (lang: Locale) => (lang === locale ? undefined : lang);

const apps = category === "apps" ? await getWorks("apps", locale) : [];
const events = category === "events" ? await getWorks("events", locale) : [];
const awards = category === "awards" ? await getWorks("awards", locale) : [];
const career = category === "career" ? await getWorks("career", locale) : [];
const count = apps.length + events.length + awards.length + career.length;
---

<div class="flex flex-col gap-4 lg:gap-6">
  <PageHead
    title={t(`works.${category}`)}
    as="h2"
    show="desktop"
    count={count}
    sortList="works-list"
    locale={locale}
  />
  {category === "career" ? (
    <ul id="works-list" class="flex flex-col gap-3">
      {career.map((entry) => (
        <li>
          <RowCard
            title={entry.data.title}
            period={formatPeriod(entry.data.start, entry.data.end)}
            summary={entry.data.summary}
            image={entry.data.thumbnail}
            initial={initialOf(entry.data.title, entry.data.initial)}
            lang={langOf(entry.lang)}
          />
        </li>
      ))}
    </ul>
  ) : (
    <ul id="works-list" class="grid grid-cols-2 gap-4 lg:grid-cols-3 lg:gap-6">
      {apps.map((entry) => (
        <li>
          <Card
            href={localizePath(`/works/apps/${entry.slug}`, locale)}
            title={entry.data.title}
            meta={formatMonth(entry.data.date)}
            image={entry.data.thumbnail}
            initial={initialOf(entry.data.title, entry.data.initial)}
            lang={langOf(entry.lang)}
          />
        </li>
      ))}
      {events.map((entry) => (
        <li>
          <Card
            href={entry.data.url}
            external
            title={entry.data.title}
            meta={formatMonth(entry.data.date)}
            image={entry.data.thumbnail}
            initial={initialOf(entry.data.title, entry.data.initial)}
            lang={langOf(entry.lang)}
          />
        </li>
      ))}
      {awards.map((entry) => (
        <li>
          <Card
            title={entry.data.title}
            meta={formatMonth(entry.data.date)}
            initial={initialOf(entry.data.title, entry.data.initial)}
            lang={langOf(entry.lang)}
          />
        </li>
      ))}
    </ul>
  )}
</div>
