---
import type { Locale } from "../i18n/config";
import { localizePath } from "../i18n/config";
import { useTranslations } from "../i18n/t";

type Section = "hello" | "about" | "works" | "press";

interface Props {
  locale: Locale;
  current: Section;
}

const { locale, current } = Astro.props;
const t = useTranslations(locale);
const items = [
  { section: "about", href: localizePath("/about", locale), label: t("nav.about") },
  { section: "works", href: localizePath("/works/apps", locale), label: t("nav.works") },
  { section: "press", href: localizePath("/press", locale), label: t("nav.press") },
] as const;
---

<nav class="nav-bar" aria-label={t("nav.label")}>
  <ul class="flex gap-1">
    {items.map((item) => (
      <li>
        <a
          href={item.href}
          class:list={[
            "nav-item text-callout",
            item.section === current ? "bg-bar-active font-bold text-on-bar" : "text-on-bar-muted",
          ]}
          aria-current={item.section === current ? "page" : undefined}
          data-cursor="block"
        >
          {item.label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .nav-bar {
    position: fixed;
    left: 50%;
    bottom: calc(var(--bottom-inset) + 8px);
    z-index: 30;
    translate: -50% 0;
    padding: 4px;
    border-radius: var(--ut-radius-full);
    background: var(--ut-color-bar);
    box-shadow: var(--ut-shadow-float);
    view-transition-name: nav-bar;
  }

  .nav-item {
    display: grid;
    place-items: center;
    width: 84px;
    height: 40px;
    border-radius: var(--ut-radius-full);
    transition:
      background-color var(--ut-duration-base) var(--ut-ease-out),
      color var(--ut-duration-base) var(--ut-ease-out);
  }

  @media (width >= 64rem) {
    .nav-bar {
      top: 14px;
      bottom: auto;
    }
  }
</style>
