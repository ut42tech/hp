---
import type { ImageMetadata } from "astro";
import type { Locale } from "../i18n/config";
import type { BrandIconName } from "../lib/icons";
import Thumb from "./Thumb.astro";

interface Props {
  href?: string;
  external?: boolean;
  title: string;
  meta: string;
  image?: ImageMetadata;
  initial: string;
  brand?: BrandIconName;
  // Set when the entry fell back to another language than the page's.
  lang?: Locale;
}

const { href, external = false, title, meta, image, initial, brand, lang } = Astro.props;
const Tag = href ? "a" : "div";
---

<Tag
  class="card"
  href={href}
  target={href && external ? "_blank" : undefined}
  rel={href && external ? "noopener" : undefined}
  lang={lang}
  data-cursor={href ? "block" : undefined}
>
  <Thumb
    image={image}
    alt=""
    initial={initial}
    brand={brand}
    widths={[264, 528]}
    sizes="(min-width: 64rem) 264px, 50vw"
    class="aspect-[16/10]"
  />
  <div class="flex flex-col gap-1 p-3">
    <p class="title text-card-title text-fg">{title}</p>
    <p class="meta truncate text-mono text-muted">{meta}</p>
  </div>
</Tag>

<style>
  .card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--ut-color-border);
    border-radius: var(--ut-radius-card);
    background: var(--ut-color-surface);
    overflow-wrap: anywhere;
  }

  /* Titles reserve two lines so every card in a row has the same height. */
  .title {
    display: -webkit-box;
    min-height: 40px;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }
</style>
