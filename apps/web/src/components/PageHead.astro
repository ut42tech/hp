---
import type { Locale } from "../i18n/config";
import { useTranslations } from "../i18n/t";
import SortButton from "./SortButton.astro";

interface Props {
  title: string;
  as?: "h1" | "h2";
  // Where the heading is visible; elsewhere it stays available to screen readers.
  show?: "both" | "mobile" | "desktop";
  count?: number;
  sortList?: string;
  locale: Locale;
}

const { title, as: Heading = "h1", show = "both", count, sortList, locale } = Astro.props;
const t = useTranslations(locale);
const hasMeta = count !== undefined || sortList !== undefined;
---

<div class="page-head">
  <Heading
    class:list={[
      "text-title-l text-fg",
      { "lg:sr-only": show === "mobile", "max-lg:sr-only": show === "desktop" },
    ]}
  >
    {title}
  </Heading>
  {hasMeta && (
    <div class="meta-row">
      {count !== undefined && (
        <span class="count text-caption text-muted">{t("count", { n: count })}</span>
      )}
      {sortList && <SortButton list={sortList} locale={locale} />}
    </div>
  )}
</div>

<style>
  .page-head {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  @media (width >= 64rem) {
    .page-head {
      flex-direction: row;
      align-items: baseline;
    }

    .meta-row {
      display: contents;
    }

    .count {
      margin-right: auto;
    }

    .meta-row :global(.sort-button) {
      align-self: center;
    }
  }
</style>
