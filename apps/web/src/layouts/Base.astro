---
import { profile } from "@ut42tech/profile";
import faviconUrl from "@ut42tech/assets/favicon.ico?url";
import "../styles/global.css";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{profile.name}</title>
    <meta name="description" content={profile.mottoEn} />
    <meta property="og:title" content={profile.name} />
    <meta property="og:description" content={profile.mottoEn} />
    <meta property="og:type" content="website" />
    <link rel="icon" href={faviconUrl} />
    <!-- Sets the theme before first paint. Keep the key and logic in sync with src/lib/theme.ts. -->
    <script is:inline>
      (() => {
        let stored = null;
        try {
          stored = localStorage.getItem("ut42tech:theme");
        } catch {}
        const prefersDark = matchMedia("(prefers-color-scheme: dark)").matches;
        const theme =
          stored === "light" || stored === "dark" ? stored : prefersDark ? "dark" : "light";
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
