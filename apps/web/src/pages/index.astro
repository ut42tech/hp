---
import { profile } from "@ut42tech/profile";
import ThemeToggle from "../components/ThemeToggle.vue";
import Base from "../layouts/Base.astro";
---

<Base>
  <main class="mx-auto max-w-2xl space-y-6 px-4 py-16">
    <ThemeToggle client:load />
    <h1 class="text-3xl font-bold">{profile.name}</h1>
    <p>{profile.motto}</p>
    <p class="text-muted">{profile.mottoEn}</p>
    <ul class="flex flex-wrap gap-3 border-t border-border pt-6">
      {profile.social.map((link) => (
        <li>
          <a class="text-accent underline" href={link.href} rel="me noopener">
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </main>
</Base>
