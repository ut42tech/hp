---
import { publishedLocales, type Locale } from "../../../i18n/config";
import { categories, type Category } from "../../../lib/works";
import WorksView from "../../../views/WorksView.astro";

export function getStaticPaths() {
  return publishedLocales.flatMap((locale) =>
    categories.map((category) => ({ params: { locale, category } })),
  );
}

const { locale, category } = Astro.params as { locale: Locale; category: Category };
---

<WorksView locale={locale} category={category} />
